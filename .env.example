# Copy to .env only on the approved deployment machine, after approval.
# Never put real credentials in this example or in chat/GitHub.
# All settings below are read only from .env; terminal environment is ignored.
RIRI_MODE=practice
SLACK_BOT_TOKEN=
NOTION_TOKEN=
# Both IDs must be explicitly filled after verification; missing IDs stop even practice.
EXPECTED_SLACK_USER_ID=
EXPECTED_SLACK_BOT_ID=
SLACK_INSTRUCTION_CHANNEL=C0CFM2HRA5V
SLACK_REPORT_CHANNEL=C0CFL6A8QJH
NOTION_VERSION=2026-03-11
NOTION_REQUESTS_PAGE_ID=413f1dff94dc81d2beebdf1b69f5c439
NOTION_LOG_PAGE_ID=413f1dff94dc816097fbfe4d4d7706b8
NOTION_REPORT_PAGE_AISU=413f1dff94dc819996a8fd6674e258ae
NOTION_REPORT_PAGE_NOA=413f1dff94dc8120bfa6d9ba516c56bb
NOTION_REPORT_PAGE_MINI=413f1dff94dc810dbec6c97de7653f30
NOTION_REPORT_PAGE_KAREN=413f1dff94dc811e9d1fc7808d2cea3f
NOTION_REPORT_PAGE_USA=413f1dff94dc81c492f6ddc54aa45dd5
# Legacy Ollama adapter only. This is NOT the verified Hermes inference endpoint.
# Keep disabled until the real inference backend/model/context is confirmed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_NUM_CTX=32768
LLM_ENABLED=false
# Notice only: never automatically delete any logs. Default is 50 MiB.
LOG_SIZE_NOTICE_BYTES=52428800
LOG_FLUSH_EVERY_MIN=180
ERROR_NOTIFY_EVERY_MIN=60
MAX_INSTRUCTION_POSTS_PER_RUN=1
MAX_POSTS_PER_RUN=4
RUN_TIMEOUT_SEC=240
# STOP_FILE defaults to STOP in this project directory.

# Disabled implementation only. Do not enable or deploy without approval.
NOA_WAKE_ENABLED=false
NOA_FIRE_URL=
NOA_FIRE_TOKEN=
